<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.dark</groupId>
        <artifactId>javaHarness</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>
    <artifactId>javaHarness-api</artifactId>
    <name>javaHarness :: api</name>
    <description>渠道与 core 共用的契约与 DTO（端口接口/请求响应模型）；不含任何渠道实现</description>

    <dependencies>
        <!-- 契约自身编译所需的框架类型。全部 optional=true：不向下游传递，
             需要这些类型的模块（server / channel-qq）自行声明，避免契约模块污染 CLI 的 classpath。
             - spring-ai-client-chat：SessionService extends ChatMemory、Message
             - reactor-core：ChatService/AgentService 返回 Flux
             - mybatis-plus-extension：SessionService 分页返回 Page、SessionEntity 注解 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-client-chat</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-extension</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- ChatRequest 的 @NotBlank -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
