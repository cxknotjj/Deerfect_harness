<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.dark</groupId>
        <artifactId>javaHarness</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>
    <artifactId>javaHarness-channel-qq</artifactId>
    <name>javaHarness :: channel-qq</name>
    <description>QQ 渠道（NapCat / OneBot 11）：仅依赖 harness-api 契约，不依赖 core 实现</description>

    <dependencies>
        <dependency>
            <groupId>com.dark</groupId>
            <artifactId>javaHarness-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- harness-api 的框架类型依赖为 optional（不向下游传递）：渠道通过 SessionService
             间接依赖 ChatMemory/Message，需自行声明（版本由 spring-ai-bom 管理） -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-client-chat</artifactId>
        </dependency>
        <!-- 渠道自带 REST 端点(/onebot/event) 与 @Configuration/@ConfigurationProperties -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- 渠道私有绑定表(onebot_session_binding) 用 MyBatis-Plus -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <!-- NapCat HTTP 客户端（版本由根 pom 锁定） -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- @ExtendWith(MockitoExtension.class)：MockitoExtension 独立于 mockito-core，
             OneBotEventServiceImplTest 用其装配 @Mock 注入（版本由 spring-boot-dependencies 管理） -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
