# LLM：默认 DeepSeek（抽取事实）；也可换成通义等任意 OpenAI 兼容端点
MEM0_LLM_BASE_URL=https://api.deepseek.com/v1
MEM0_LLM_API_KEY=
MEM0_LLM_MODEL=deepseek-chat

# Embedding：默认 DashScope text-embedding-v3（DeepSeek 没有 embedding 接口）
MEM0_EMBEDDER_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MEM0_EMBEDDER_API_KEY=
MEM0_EMBEDDER_MODEL=text-embedding-v3

# 本地数据目录（Chroma 文件持久化）与集合名
MEM0_DATA_DIR=./data
MEM0_COLLECTION=memories

# 关闭 mem0 库的匿名遥测
MEM0_TELEMETRY=false
