<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.dark</groupId>
        <artifactId>deerfect-harness</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>
    <artifactId>deerfect-harness-api</artifactId>
    <name>deerfect-harness-api</name>
    <description>渠道与 core 共用的契约与 DTO（端口接口/请求响应模型）；不含任何渠道实现</description>

    <properties>
        <!-- 覆盖率门槛（LINE）：实测 63.6%（2026-11-07 全量测试），留约 2 个点余量。
             低于此值 mvn verify 失败；改动后按实测定，不要为通过而放水 -->
        <jacoco.line.minimum>0.61</jacoco.line.minimum>
    </properties>

    <dependencies>
        <!-- 契约自身编译所需的框架类型。全部 optional=true：不向下游传递，
             需要这些类型的模块（server / channel-qq）自行声明，避免契约模块污染 CLI 的 classpath。
             - spring-ai-client-chat：SessionService extends ChatMemory、Message
             - reactor-core：ChatService/AgentService 返回 Flux
             注：持久化依赖（mybatis-plus）已移出——SessionEntity 搬回 server，
                 分页改用 view.PageResult，契约层不再需要任何 ORM 类型 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-client-chat</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- ChatRequest 的 @NotBlank -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 测试：纯 JUnit 5 + Jackson 3（契约 DTO 的 JSON 字段名守卫），版本由 Spring Boot BOM 管理 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
