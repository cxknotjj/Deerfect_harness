<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.dark</groupId>
        <artifactId>javaHarness</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>
    <artifactId>javaHarness-server</artifactId>
    <name>javaHarness :: server</name>
    <description>服务端：Agent 编排框架本体（controller/service/agent/prompt/tool/channel），spring-boot fat jar 交付</description>

    <dependencies>
        <!-- 模块内契约：共享 DTO 与跨端枚举 -->
        <dependency>
            <groupId>com.dark</groupId>
            <artifactId>javaHarness-shared</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
 Spring AI：OpenAI 及其他兼容接口（DeepSeek 等）-->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!-- Spring AI Alibaba：Graph 状态编排（节点 + 边 + 状态机，支持条件/并行边、持久化检查点） -->
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-graph-core</artifactId>
        </dependency>

        <!-- Spring AI Alibaba：Sandbox 容器级沙箱（agentscope-runtime，Docker 后端；版本由 BOM 管理）。
             排除其传递引入的 commons-logging：与 Spring 自带 spring-jcl 冲突，
             启动时报 "Standard Commons Logging discovery in action" 警告 -->
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-sandbox</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>commons-logging</groupId>
                    <artifactId>commons-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Model Context Protocol 客户端：把外部 MCP Server（STDIO / HTTP / SSE）暴露的工具注册为
             Spring AI ToolCallback，供专家 agent 按权限调用（扩展工具生态，不再逐个自研）。版本由 BOM 管理 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-client</artifactId>
        </dependency>

        <!-- RAG 知识库：pgvector 向量库（版本由 spring-ai-bom 管理）。
             PostgreSQL 实例需自备且启用 vector 扩展；vector_store 表由 PgVectorStore
             initializeSchema 自建（不经 Flyway——主库 schema 管理仍是 MySQL）。
             手动装配（config/KnowledgeConfig），不引 starter 的 autoconfigure：
             项目主数据源是 MySQL，pgvector autoconfigure 默认注入唯一 DataSource 的假设不成立 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-pgvector-store</artifactId>
        </dependency>
        <!-- PostgreSQL 驱动：仅知识库向量数据源使用 -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- MCP 服务端（本项目自建，HTTP/Streamable transport，暴露演示工具供客户端连接，
             与上面 mcp-client 形成进程内闭环演示）。版本由 BOM 管理 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
        </dependency>

        <!-- OkHttp：QQ 渠道 NapCat HTTP API 调用（channel/qq 包）。版本由根 pom dependencyManagement 锁定 -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
        </dependency>

        <!-- jsoup：WebTools 网页抓取与 HTML5 解析（编码自动嗅探，GBK 站不再乱码；DOM 级去噪）。
             MIT、单 jar 零传递依赖，仅在服务端工具使用。版本由根 pom dependencyManagement 锁定 -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
        </dependency>

        <!-- JDBC + MySQL 驱动 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway：schema 版本化迁移（替代 spring.sql.init），MySQL 8.4 需 flyway-mysql 方言模块 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- MyBatis-Plus（Spring Boot 3 专用 starter） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>

        <!-- 参数校验（jakarta validation） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
