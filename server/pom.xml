<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.dark</groupId>
        <artifactId>javaHarness</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>
    <artifactId>javaHarness-server</artifactId>
    <name>javaHarness :: server</name>
    <description>服务端：Agent 编排框架本体（controller/service/agent/prompt/tool），spring-boot fat jar 交付</description>

    <dependencies>
        <dependency>
            <groupId>com.dark</groupId>
            <artifactId>javaHarness-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 运行期装配 QQ 渠道（编译期不可见 → core 无法 import channel） -->
        <dependency>
            <groupId>com.dark</groupId>
            <artifactId>javaHarness-channel-qq</artifactId>
            <version>${project.version}</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
 Spring AI：OpenAI 及其他兼容接口（DeepSeek 等）-->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!-- 容器级沙箱运行时（agentscope-runtime，Docker 后端）：直接依赖其 core 模块，
             不经 Spring AI Alibaba 封装。排除传递引入的 commons-logging：与 Spring 自带
             spring-jcl 冲突，启动时报 "Standard Commons Logging discovery in action" 警告 -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-runtime-sandbox-core</artifactId>
            <version>${agentscope.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>commons-logging</groupId>
                    <artifactId>commons-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Agentic SIMPLE 路径：AgentScope Java 的 Agent 框架（ReActAgent）与 OpenAI 兼容模型扩展。
             MCP 由 Spring AI 提供（ToolCallback 桥接），显式排除 AgentScope 自带的
             MCP SDK 0.17.2，避免与项目 2.1.0 同 artifact 冲突。 -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-core</artifactId>
            <version>${agentscope.agent.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>io.modelcontextprotocol.sdk</groupId>
                    <artifactId>mcp</artifactId>
                </exclusion>
                <!-- AgentScope 自带 victools 4.38.0 会覆盖 Spring AI 需要的 5.0.0，
                     导致 ToolDefinitions 缺 JacksonSchemaModule，工具 Schema 生成失败 -->
                <exclusion>
                    <groupId>com.github.victools</groupId>
                    <artifactId>jsonschema-generator</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.github.victools</groupId>
                    <artifactId>jsonschema-module-jackson</artifactId>
                </exclusion>
                <!-- AgentScope 自带 networknt json-schema-validator 2.0.0（仅 Jackson 2 API），
                     会覆盖 MCP SDK 2.1.0 需要的 3.0.6（Jackson 3 API），启动时 mcpSyncServer
                     调用 Schema.validate(tools.jackson.databind.JsonNode) 报 NoSuchMethodError。
                     3.0.6 保留 Jackson 2 方法，AgentScope 侧调用仍可解析。 -->
                <exclusion>
                    <groupId>com.networknt</groupId>
                    <artifactId>json-schema-validator</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-model-openai</artifactId>
            <version>${agentscope.agent.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>io.modelcontextprotocol.sdk</groupId>
                    <artifactId>mcp</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.github.victools</groupId>
                    <artifactId>jsonschema-generator</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.github.victools</groupId>
                    <artifactId>jsonschema-module-jackson</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.networknt</groupId>
                    <artifactId>json-schema-validator</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Model Context Protocol 客户端：把外部 MCP Server（STDIO / HTTP / SSE）暴露的工具注册为
             Spring AI ToolCallback，供专家 agent 按权限调用（扩展工具生态，不再逐个自研）。版本由 BOM 管理 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-client</artifactId>
        </dependency>

        <!-- RAG 知识库：pgvector 向量库（版本由 spring-ai-bom 管理）。
             PostgreSQL 实例需自备且启用 vector 扩展；vector_store 表由 PgVectorStore
             initializeSchema 自建（不经 Flyway——主库 schema 管理仍是 MySQL）。
             手动装配（config/KnowledgeConfig），不引 starter 的 autoconfigure：
             项目主数据源是 MySQL，pgvector autoconfigure 默认注入唯一 DataSource 的假设不成立 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-pgvector-store</artifactId>
        </dependency>
        <!-- PostgreSQL 驱动：仅知识库向量数据源使用 -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- MCP 服务端（本项目自建，HTTP/Streamable transport，暴露演示工具供客户端连接，
             与上面 mcp-client 形成进程内闭环演示）。版本由 BOM 管理 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
        </dependency>

        <!-- jsoup：WebTools 网页抓取与 HTML5 解析（编码自动嗅探，GBK 站不再乱码；DOM 级去噪）。
             MIT、单 jar 零传递依赖，仅在服务端工具使用。版本由根 pom dependencyManagement 锁定 -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
        </dependency>

        <!-- JDBC + MySQL 驱动 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway：schema 版本化迁移（替代 spring.sql.init），MySQL 8.4 需 flyway-mysql 方言模块。
             Boot 4 起 Flyway 自动配置拆到独立模块 spring-boot-flyway，经 starter 引入
             （仅 flyway-core 时自动配置不生效、迁移不会执行） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- MyBatis-Plus（Spring Boot 3 专用 starter） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>

        <!-- 参数校验（jakarta validation） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>ban-core-on-channel</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <!-- core(server) 不得 compile 依赖渠道模块 -->
                                    <excludes>
                                        <exclude>com.dark:javaHarness-channel-qq:*:*:compile</exclude>
                                    </excludes>
                                    <searchTransitive>false</searchTransitive>
                                </bannedDependencies>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
